# syntax=docker/dockerfile:1
#
# Backend + web UI in one container, for running everything locally:
#
#   docker build -f Dockerfile.fullstack -t hospital-app . && docker run --rm -p 8000:8000 -p 5173:5173 hospital-app
#
#   UI:  http://localhost:5173     API: http://localhost:8000/docs
#
# The plain Dockerfile (backend only) is still what Render deploys.

# ---- 1. Build the frontend to static files -----------------------------------
FROM node:22-slim AS frontend

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend ./
# The browser calls the API directly, so this is the URL as seen from the host.
ARG VITE_API_URL=http://localhost:8000
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ---- 2. Runtime: uvicorn for the API, nginx for the UI -----------------------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY app ./app
COPY --from=frontend /frontend/dist ./frontend

# nginx runs unprivileged, so its pid file and temp dirs live in /tmp.
COPY <<'EOF' /etc/nginx/nginx.conf
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {}

http {
    include /etc/nginx/mime.types;
    access_log off;
    client_body_temp_path /tmp/nginx-client;
    proxy_temp_path /tmp/nginx-proxy;
    fastcgi_temp_path /tmp/nginx-fastcgi;
    uwsgi_temp_path /tmp/nginx-uwsgi;
    scgi_temp_path /tmp/nginx-scgi;

    server {
        listen 5173;
        root /app/frontend;

        # Client-side routes (/history, /batches/<id>) all load index.html.
        location / {
            try_files $uri /index.html;
        }

        # Built assets have content hashes in their names.
        location /assets/ {
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }
}
EOF

# Starts both servers. If either one exits, the other is stopped too, so the
# container never runs half-alive. SIGTERM (docker stop) is passed to both,
# which lets uvicorn drain running batches as in the backend-only image.
COPY --chmod=755 <<'EOF' /app/start.sh
#!/bin/bash
stop() { kill -TERM "$api" "$web" 2>/dev/null; }
trap stop TERM INT

uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --timeout-graceful-shutdown 20 &
api=$!
nginx -g 'daemon off;' &
web=$!

wait -n
stop
wait
EOF

RUN useradd --system --uid 10001 --no-create-home appuser
USER appuser

EXPOSE 8000 5173

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request as u; [u.urlopen(x, timeout=4) for x in ('http://127.0.0.1:8000/health', 'http://127.0.0.1:5173/')]"

CMD ["/app/start.sh"]
